{
  "title": "AegisGate Stage 1",
  "uid": "aegisgate-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "aegisgate"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Successful requests",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(aegisgate_requests_successful_total[20s]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP errors and gateway rejections",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(aegisgate_http_responses_total{status=~\"[45]..\"}[20s])) or sum by (instance) (0 * aegisgate_requests_total)",
          "legendFormat": "{{instance}} HTTP 4xx/5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(aegisgate_requests_rejected_total[20s]))",
          "legendFormat": "{{instance}} gateway rejections",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(aegisgate_request_duration_seconds_bucket[20s])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aegisgate_request_duration_seconds_bucket[20s])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(aegisgate_request_duration_seconds_bucket[20s])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Connections and pending requests",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (aegisgate_http_connections)",
          "legendFormat": "{{instance}} clients",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (instance, stage) (aegisgate_pending_requests)",
          "legendFormat": "{{instance}} pending {{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Successful upstream p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(aegisgate_upstream_duration_seconds_bucket[20s])))",
          "legendFormat": "{{backend}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backend health",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (instance, backend) (aegisgate_backend_healthy)",
          "legendFormat": "{{instance}} {{backend}} (1 healthy)",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Circuit breaker states",
      "description": "0 closed, 1 open, 2 half-open.",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegisgate_circuit_state",
          "legendFormat": "{{instance}} {{backend}} worker {{worker}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Circuit transitions",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, state) (increase(aegisgate_circuit_transitions_total[30s]))",
          "legendFormat": "{{backend}} → {{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate-limit rejections",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(aegisgate_rate_rejections_total[20s]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis reservation operations",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aegisgate_redis_commands_total[20s]))",
          "legendFormat": "EVAL commands",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(aegisgate_redis_reservations_total{reason=~\"redis_.*\"}[20s]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Process CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(process_cpu_seconds_total[20s]))",
          "legendFormat": "{{instance}} (one CPU = 100%)",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Resident memory",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{instance}} RSS",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Backend failures and deadlines",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, reason) (rate(aegisgate_backend_failures_total[20s]))",
          "legendFormat": "{{backend}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Redis queue and connection",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aegisgate_redis_queue_depth",
          "legendFormat": "{{instance}} pending",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "aegisgate_redis_connected",
          "legendFormat": "{{instance}} connected",
          "datasource": {
            "type": "prometheus",
            "uid": "aegis-prometheus"
          },
          "range": true
        }
      ]
    }
  ]
}
